if [ -f .env.test ]; then
    export $(grep -v '^#' .env.test | xargs)
    export NODE_ENV=test
fi

# Format staged files before anything else looks at them. CI checks formatting on the files a
# pull request touches, not the whole tree — main still carries a large pre-Prettier backlog
# that cannot be swept in one commit without conflicting with every subtree host. Formatting
# on the way in is what stops that backlog from growing.
STAGED_FORMATTABLE=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|jsx|mjs|ts|tsx|json|css|scss|md|ya?ml)$' || true)

# Prettier rewrites the file in the working tree and the `git add` below stages it whole, so a
# file that also carries unstaged edits would have them committed along with it. Format only the
# files whose staged content is all there is; the rest are left to the author.
FORMATTABLE=""
UNFORMATTED=""
UNSTAGED=$(git diff --name-only --diff-filter=ACMR)

for file in $STAGED_FORMATTABLE; do
    if echo "$UNSTAGED" | grep -qxF "$file"; then
        UNFORMATTED="$UNFORMATTED $file"
    else
        FORMATTABLE="$FORMATTABLE $file"
    fi
done

if [ -n "$FORMATTABLE" ]; then
    echo "Formatting staged files..."
    # shellcheck disable=SC2086
    pnpm exec prettier --write --ignore-unknown $FORMATTABLE

    if [ $? -ne 0 ]; then
        echo "Prettier failed. Commit aborted."
        exit 1
    fi

    # Re-stage whatever Prettier rewrote, so the commit matches what was checked.
    # shellcheck disable=SC2086
    git add $FORMATTABLE
fi

if [ -n "$UNFORMATTED" ]; then
    echo "Not formatted (unstaged changes in the same file):$UNFORMATTED"
fi

echo "Running ESLint..."

# Get list of staged JS/TS/TSX files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|jsx|ts|tsx)$' || true)

if [ -z "$STAGED_FILES" ]; then
    echo "No JS/TS files staged for commit. Skipping ESLint."
else
    echo "Linting staged files:"
    echo "$STAGED_FILES"

    # Run ESLint on staged files
    pnpm exec eslint $STAGED_FILES

    # Check exit code
    if [ $? -ne 0 ]; then
        echo "ESLint found errors. Commit aborted."
        echo "Fix the errors or use 'git commit --no-verify' to bypass this hook."
        exit 1
    fi

    echo "ESLint passed."
fi

# Run unit tests for staged files
if [ -n "$STAGED_FILES" ]; then
    echo "Running unit tests for staged files..."
    
    # Find corresponding test files for staged source files
    TEST_FILES=""
    # `case`, not `[[ ]]`: husky runs this hook with sh, where the bash test never matched and
    # every staged test file was quietly skipped.
    for file in $STAGED_FILES; do
        case "$file" in
            # Integration tests need a different config; CI runs them.
            *.integration.test.*) ;;
            *.test.* | *.spec.*) TEST_FILES="$TEST_FILES $file" ;;
            *)
                # Look for test files in common patterns
                test_file=$(echo "$file" | sed -E 's/\.(js|jsx|ts|tsx)$/.test.\1/')
                if [ -f "$test_file" ]; then
                    TEST_FILES="$TEST_FILES $test_file"
                fi

                # Also check for .spec.js/ts files
                spec_file=$(echo "$file" | sed -E 's/\.(js|jsx|ts|tsx)$/.spec.\1/')
                if [ -f "$spec_file" ]; then
                    TEST_FILES="$TEST_FILES $spec_file"
                fi
                ;;
        esac
    done
    
    if [ -n "$TEST_FILES" ]; then
        echo "Running tests for: $TEST_FILES"
        pnpm exec vitest run $TEST_FILES --passWithNoTests
        
        if [ $? -ne 0 ]; then
            echo "Unit tests failed. Commit aborted."
            echo "Fix the failing tests or use 'git commit --no-verify' to bypass this hook."
            exit 1
        fi
    else
        echo "No test files found for staged changes. Skipping tests."
    fi
    
    echo "Unit tests passed."
else
    echo "No JS/TS files staged. Skipping unit tests."
fi

echo "All checks passed. Proceeding with commit."
exit 0
