{
  "name": "chaicore",
  "version": "0.1.0",
  "description": "ChaiBuilder Core - Open source AI enabled website builder for Next.js",
  "author": "Suraj Air",
  "license": "BSD-3-Clause",
  "homepage": "https://chaibuilder.com",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaibuilder/core.git"
  },
  "bugs": {
    "url": "https://github.com/chaibuilder/core/issues"
  },
  "keywords": [
    "website-builder",
    "page-builder",
    "visual-editor",
    "nextjs",
    "react",
    "tailwindcss",
    "cms",
    "low-code",
    "ai"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0",
  "files": [
    "dist",
    "scripts/generate-styles.mjs"
  ],
  "bin": {
    "chai-styles": "./scripts/generate-styles.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "main": "dist/builder.js",
  "sideEffects": true,
  "scripts": {
    "dev": "tsup --watch --format esm,cjs",
    "build": "NODE_OPTIONS='--max-old-space-size=6144' tsup --format esm,cjs && NODE_OPTIONS='--max-old-space-size=6144' node scripts/build-dts.mjs",
    "build:dts": "NODE_OPTIONS='--max-old-space-size=6144' node scripts/build-dts.mjs",
    "test": "vitest --run",
    "test:integration": "vitest --run --config vitest.config.integration.ts",
    "test:integration:watch": "vitest --config vitest.config.integration.ts",
    "db:test:generate": "drizzle-kit generate --config drizzle.config.test.ts",
    "db:test:studio": "drizzle-kit studio --config drizzle.config.test.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "vendor:tailwind-css": "node scripts/vendor-tailwind-v4-css.mjs",
    "prepare": "husky || true"
  },
  "exports": {
    ".": {
      "types": "./dist/builder.d.ts",
      "import": "./dist/builder.js",
      "require": "./dist/builder.cjs"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js",
      "require": "./dist/registry.cjs"
    },
    "./web-blocks": {
      "types": "./dist/web-blocks.d.ts",
      "import": "./dist/web-blocks.js",
      "require": "./dist/web-blocks.cjs"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./styles": {
      "import": "./dist/builder.css",
      "require": "./dist/builder.css"
    },
    "./ui/*": {
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/components/ui/*.js",
      "require": "./dist/components/ui/*.cjs"
    },
    "./nextjs": {
      "types": "./dist/nextjs.d.ts",
      "import": "./dist/nextjs.js",
      "require": "./dist/nextjs.cjs"
    },
    "./nextjs/server": {
      "types": "./dist/nextjs/server.d.ts",
      "import": "./dist/nextjs/server.js",
      "require": "./dist/nextjs/server.cjs"
    },
    "./nextjs/render": {
      "types": "./dist/nextjs/render.d.ts",
      "import": "./dist/nextjs/render.js",
      "require": "./dist/nextjs/render.cjs"
    },
    "./nextjs/render-client": {
      "types": "./dist/nextjs/render-client.d.ts",
      "import": "./dist/nextjs/render-client.js",
      "require": "./dist/nextjs/render-client.cjs"
    },
    "./db/libsql": {
      "types": "./dist/db/libsql.d.ts",
      "import": "./dist/db/libsql.js",
      "require": "./dist/db/libsql.cjs"
    },
    "./db/d1": {
      "types": "./dist/db/d1.d.ts",
      "import": "./dist/db/d1.js",
      "require": "./dist/db/d1.cjs"
    },
    "./db/better-sqlite3": {
      "types": "./dist/db/better-sqlite3.d.ts",
      "import": "./dist/db/better-sqlite3.js",
      "require": "./dist/db/better-sqlite3.cjs"
    },
    "./db/schema-sqlite": {
      "types": "./dist/db/schema-sqlite.d.ts",
      "import": "./dist/db/schema-sqlite.js",
      "require": "./dist/db/schema-sqlite.cjs"
    },
    "./db/relations-sqlite": {
      "types": "./dist/db/relations-sqlite.d.ts",
      "import": "./dist/db/relations-sqlite.js",
      "require": "./dist/db/relations-sqlite.cjs"
    },
    "./plugins/client": {
      "types": "./dist/plugins/client.d.ts",
      "import": "./dist/plugins/client.js",
      "require": "./dist/plugins/client.cjs"
    },
    "./plugins/page-errors/client": {
      "types": "./dist/plugins/page-errors/client.d.ts",
      "import": "./dist/plugins/page-errors/client.js",
      "require": "./dist/plugins/page-errors/client.cjs"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "import": "./dist/tailwind.js",
      "require": "./dist/tailwind.cjs"
    },
    "./ai/openrouter": {
      "types": "./dist/ai/openrouter.d.ts",
      "import": "./dist/ai/openrouter.js",
      "require": "./dist/ai/openrouter.cjs"
    },
    "./ai/openai-compatible": {
      "types": "./dist/ai/openai-compatible.d.ts",
      "import": "./dist/ai/openai-compatible.js",
      "require": "./dist/ai/openai-compatible.cjs"
    },
    "./plugins/empty-page-starter/client": {
      "types": "./dist/plugins/empty-page-starter/client.d.ts",
      "import": "./dist/plugins/empty-page-starter/client.js",
      "require": "./dist/plugins/empty-page-starter/client.cjs"
    }
  },
  "peerDependencies": {
    "@ai-sdk/openai-compatible": ">=2.0.0",
    "@libsql/client": ">=0.14.0",
    "@openrouter/ai-sdk-provider": ">=2.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "ai": ">=6.0.0",
    "better-sqlite3": ">=11.0.0",
    "drizzle-orm": ">=0.44.0",
    "next": ">=15.3.0",
    "@next/third-parties": ">=15.3.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwindcss": "^4.0.0",
    "workers-ai-provider": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/openai-compatible": {
      "optional": true
    },
    "@openrouter/ai-sdk-provider": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "@next/third-parties": {
      "optional": true
    },
    "@tailwindcss/postcss": {
      "optional": true
